#!/bin/sh
# Runs as root after dpkg unpacks the app.
set -e

chmod -R 755 /Applications/Veteris.app
chown -R root:wheel /Applications/Veteris.app 2>/dev/null || true

if command -v uicache >/dev/null 2>&1; then
    uicache -p /Applications/Veteris.app >/dev/null 2>&1 || uicache -a >/dev/null 2>&1 || true
fi

exit 0
